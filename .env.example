# Argus process environment variable examples
# Argus does NOT load .env files automatically. Export these variables through
# your terminal or service manager; keep actual deployment values private.
# Names follow ARGUS__<SECTION>__<KEY>, matching the YAML configuration tree.

# Log level: DEBUG, INFO, WARNING, ERROR
ARGUS__LOG_LEVEL=INFO

# Authentication (required for production deployment)
ARGUS__AUTH__ENABLED=true
ARGUS__AUTH__API_TOKEN=replace-with-a-long-random-token

# Dashboard
ARGUS__DASHBOARD__HOST=127.0.0.1
ARGUS__DASHBOARD__PORT=8080

# Optional outbound webhook; the URL is a documentation placeholder.
ARGUS__ALERTS__WEBHOOK__ENABLED=false
ARGUS__ALERTS__WEBHOOK__URL=https://webhook.example/argus/alerts
